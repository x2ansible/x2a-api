user nginx;
worker_processes <%= node['nginx_firewall']['worker_processes'] %>;

events {
    worker_connections 1024;
}

http {
    server {
        listen <%= node['nginx_firewall']['http_port'] %>;
        server_name localhost;

        location / {
            root   /usr/share/nginx/html;
            index  index.html index.htm;
        }
    }
}
